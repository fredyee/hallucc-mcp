# HallucC 后端地址（现有 FastAPI，默认 :8001）
HALLUCC_BASE_URL=http://127.0.0.1:8001
# MCP server 监听端口
PORT=8787
# 请求后端超时（毫秒），单次检测可能较长
BACKEND_TIMEOUT_MS=120000
# 是否允许「无 key」做发现类调用（initialize / tools/list / ping）。
# 默认 1：注册表与目录站靠 tools/list 收录，这类方法只读、不发后端、不泄密。
# 设 0 = 所有方法都要求格式合法的 key（hc_ + 48 位 hex）。
# MCP_ALLOW_ANON_DISCOVERY=1
