{
  "name": "hallucc-mcp",
  "version": "0.1.5",
  "description": "HallucC MCP server — claim-by-claim AI hallucination detection with sources, agent trajectory verification, CUA risk gating, prompt-injection guard. Thin proxy to the HallucC backend.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "hallucc-mcp": "dist/src/stdio.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fredyee/hallucc-mcp.git"
  },
  "homepage": "https://aihcc.cloud",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hallucination-detection",
    "ai-agent",
    "prompt-injection",
    "rag",
    "claude",
    "cursor",
    "computer-use",
    "agent-safety"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "start:stdio": "tsx src/stdio.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
